{
  "configurations": [
    {
      "name": "Loot und Barrieren kombiniert",
      "output": "loot_barrier_cards",
      "meinspielCardCount": 110,
      "cardSets": [
        {
          "name": "Loot Cards",
          "template": "loot_template.svg",
          "backcard": "npc_card_back_diamonds.svg",
          "titlecard": "title_loot.svg",
          "data": "loot_settings.csv"
        },
        {
          "name": "Barrier Cards",
          "template": "barriers_template.svg",
          "backcard": "npc_card_back_clubs.svg",
          "titlecard": "title_barriers.svg",
          "data": "barrier_settings.csv"
        }
      ]
    },
    {
      "name": "Loot Cards",
      "template": "loot_template.svg",
      "backcard": "npc_card_back_diamonds.svg",
      "titlecard": "title_loot.svg",
      "data": "loot_settings.csv",
      "output": "loot_cards"
    },
    {
      "name": "Barrier Cards",
      "template": "barriers_template.svg",
      "backcard": "npc_card_back_clubs.svg",
      "titlecard": "title_barriers.svg",
      "data": "barrier_settings.csv",
      "output": "barrier_cards"
    },
    {
      "name": "Enemy Cards",
      "template": "npc_template_enemy.svg",
      "backcard": "npc_card_back_sprades.svg",
      "titlecard": "title_enemies.svg",
      "data": "npc_settings_normal.csv",
      "output": "enemy_cards"
    },
    {
      "name": "Wildcard Enemy Cards",
      "template": "npc_template_enemy.svg",
      "backcard": "npc_card_back_sprades_wc.svg",
      "titlecard": "title_enemies_wc.svg",
      "data": "npc_settings_wc.csv",
      "output": "wildcard_enemy_cards"
    },
    {
      "name": "Encounter Cards",
      "template": "npc_template_enemy.svg",
      "backcard": "npc_card_back_hearts.svg",
      "titlecard": "title_encounters.svg",
      "data": "npc_settings_encounter.csv",
      "output": "encounter_cards"
    }
  ],
  "fields": {
    "skills_text": {
      "type": "skillLabels",
      "defaultValue": ""
    },
    "skills_dices": {
      "type": "skillDice",
      "source": "skills_text",
      "defaultValue": "",
      "lineHeightFrom": "skills_text"
    },
    "edges": {
      "type": "list",
      "offsetAfter": [
        "skills_text"
      ]
    },
    "weapons": {
      "type": "list"
    },
    "description": {
      "type": "text",
      "wrapLength": 29,
      "offsetAfter": [
        "skills_text",
        "edges"
      ],
      "offsetY": 0.5
    },
    "name_short": {
      "type": "text",
      "wrapLength": 16
    },
    "fail_text": {
      "type": "text",
      "wrapLength": 20
    },
    "consumption": {
      "aliases": [
        "consumtion"
      ]
    },
    "consumtion": {
      "aliases": [
        "consumption"
      ]
    },
    "mob_typ": {
      "aliases": [
        "mob_type"
      ]
    },
    "mob_type": {
      "aliases": [
        "mob_typ"
      ]
    }
  }
}
